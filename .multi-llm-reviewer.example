version = 1

# Reviewer definitions replace the complete reviewer list from the lower-priority
# configuration. The review prompt is sent to every command over stdin.
[[reviewers]]
name = "Agy"
commands = [
  ["agy", "--print", "--mode", "plan", "--sandbox", "--output-format", "text", "--disable-slash-commands"],
]

[[reviewers]]
name = "Copilot"
commands = [
  ["copilot", "--silent", "--no-ask-user", "--allow-all-tools", "--available-tools=view,glob,grep", "--disable-builtin-mcps", "--deny-tool=write", "--deny-tool=shell", "--deny-tool=url"],
]

[[reviewers]]
name = "Codex"
commands = [
  ["codex", "exec", "--sandbox", "read-only", "--ephemeral", "-"],
]

# Fixers are tried in this order after the selected primary fixer. Command keys
# are merged by name, so a repository can override one user-level command.
[fixers]
order = ["agy", "copilot", "codex"]

[fixers.commands]
agy = ["agy", "--print", "--mode", "accept-edits", "--dangerously-skip-permissions", "--output-format", "text", "--disable-slash-commands"]
copilot = ["copilot", "--silent", "--no-ask-user", "--allow-all-tools"]
codex = ["codex", "exec", "--approve-for-me", "--ephemeral", "-"]

[local_reviewer]
name = "LocalLlama3 (優先)"
commands = [["ollama", "run", "llama3"]]

[local_fixers]
llama3-fix = ["ollama", "run", "llama3"]
